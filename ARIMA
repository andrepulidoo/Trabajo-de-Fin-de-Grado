import pandas as pd
import numpy as np
import os
from statsmodels.tsa.arima.model import ARIMA
from sklearn.metrics import mean_absolute_error, mean_squared_error
import warnings
warnings.filterwarnings('ignore')

os.chdir(r'C:/Users/andre/OneDrive/Documentos/TFG')

empresas = ['microsoft', 'meta', 'google', 'amazon']
nombres  = ['Microsoft', 'Meta', 'Alphabet', 'Amazon']
horizontes = [5, 10, 20]  # horizontes de predicción en días hábiles

# split 90% entrenamiento / 10% test
TRAIN_RATIO = 0.90

# lista donde iremos guardando los resultados de cada empresa y horizonte
resultados = []

for empresa, nombre in zip(empresas, nombres):

    # cargamos el dataset final de cada empresa
    df = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True)

    # ARIMA solo necesita la serie de precios de cierre ajustado
    # no usamos variables exógenas (eso sería ARIMAX)
    serie = df['adj_close']

    # dividimos en train y test respetando el orden temporal
    # nunca se mezclan datos futuros con pasados
    n = len(serie)
    n_train = int(n * TRAIN_RATIO)

    train = serie.iloc[:n_train]
    test  = serie.iloc[n_train:]

    print(f"\n{nombre}: train={len(train)} obs, test={len(test)} obs")

    for h in horizontes:

        y_true = []  # valores reales
        y_pred = []  # valores predichos

        # WALK-FORWARD VALIDATION:
        # simulamos cómo funcionaría el modelo en producción real.
        # en cada paso i, el modelo solo ve datos hasta ese momento,
        # predice h días adelante, y luego avanzamos un día.
        # esto evita cualquier filtración de información futura.
        for i in range(len(test) - h + 1):

            # historia disponible en el momento de predicción:
            # todo el train + los primeros i días del test
            historia = pd.concat([train, test.iloc[:i]])

            try:
                # ARIMA(0,1,0): sin componente AR ni MA, solo diferenciación
                # esto equivale a un random walk: la mejor predicción
                # es el último valor conocido, lo cual es consistente
                # con los resultados de los tests ADF y los gráficos ACF/PACF
                modelo = ARIMA(historia, order=(0, 1, 0)).fit()

                # predicción recursiva: el modelo predice paso a paso
                # hasta llegar al horizonte h deseado
                forecast = modelo.forecast(steps=h)

                # nos quedamos con el último valor del forecast (el día t+h)
                pred = forecast.iloc[-1]

                # valor real en t+h
                real = test.iloc[i + h - 1]

                y_pred.append(pred)
                y_true.append(real)

            except:
                # si el modelo falla en algún paso, lo saltamos
                continue

        # convertimos a arrays para calcular métricas
        y_true = np.array(y_true)
        y_pred = np.array(y_pred)

        # métricas de error:
        # MAE  — error absoluto medio (en USD)
        # RMSE — raíz del error cuadrático medio (penaliza más los errores grandes)
        # MAPE — error porcentual medio (permite comparar entre empresas)
        mae  = mean_absolute_error(y_true, y_pred)
        rmse = np.sqrt(mean_squared_error(y_true, y_pred))
        mape = np.mean(np.abs((y_true - y_pred) / y_true)) * 100

        print(f"  h={h:2d} días: MAE={mae:.3f}  RMSE={rmse:.3f}  MAPE={mape:.2f}%")

        # guardamos los resultados de esta combinación empresa-horizonte
        resultados.append({
            'empresa': nombre,
            'horizonte': h,
            'MAE': round(mae, 3),
            'RMSE': round(rmse, 3),
            'MAPE': round(mape, 2)
        })

# guardamos todos los resultados en un CSV para usarlos después
df_resultados = pd.DataFrame(resultados)
df_resultados.to_csv('resultados_arima.csv', index=False)
print("\nResultados guardados → resultados_arima.csv")
