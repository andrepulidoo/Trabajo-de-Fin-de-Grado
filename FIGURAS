# FIGURA 4 - Distribución de retornos simples

fig, axes = plt.subplots(2, 2, figsize=(14, 10))
fig.suptitle('Distribución de los Retornos Simples por Empresa (2020–2025)',
             fontsize=18, fontweight='bold')
axes = axes.flatten()

for i, (empresa, nombre) in enumerate(zip(empresas, nombres)):
    df = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True)
    retornos = df['retorno_simple'].dropna()
    ax = axes[i]

    ax.hist(retornos, bins=80, color=colores[empresa], alpha=0.85, edgecolor='white', linewidth=0.3)

    # marco la media para ver si los retornos estan sesgados hacia un lado
    media = retornos.mean()
    ax.axvline(media, color='black', linewidth=1.2, linestyle='--', label=f'Media: {media:.3f}')

    ax.set_title(nombre, fontweight='bold', fontsize=16)
    ax.set_xlabel('Retorno simple (u.m.)')
    ax.set_ylabel('Frecuencia')
    ax.legend(fontsize=13)
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('fig4_distribucion_retornos.png', dpi=150, bbox_inches='tight')
plt.show()



# FIGURA 5 - Matrices de correlación entre variables

# variables independientes que uso en el modelo
variables = ['retorno_simple', 'close_lag1', 'volume_lag1',
             'volatilidad_20_lag1', 'vader_lag1', 'finbert_lag1']

# nombres mas cortos para que quepan bien en la matriz
etiquetas_vars = ['retorno_simple', 'close_lag1', 'volume_lag1',
                  'volat._lag1', 'vader_lag1', 'finbert_lag1']

# genero una matriz por empresa
for empresa, nombre in zip(empresas, nombres):
    df = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True)
    corr_matrix = df[variables].corr()
    corr_matrix.index   = etiquetas_vars
    corr_matrix.columns = etiquetas_vars

    cmap_custom = mcolors.LinearSegmentedColormap.from_list(
        'custom', ['#7B4F9E', '#FFFFFF', colores[empresa]], N=256
    )

    fig, ax = plt.subplots(figsize=(8, 7))
    sns.heatmap(
        corr_matrix.round(3),
        annot=True, fmt=".3f",
        cmap=cmap_custom,
        center=0, vmin=-1, vmax=1,  # centro en 0 para que los negativos y positivos se vean igual
        linewidths=0.5, linecolor='white',
        ax=ax,
        annot_kws={"size": 12, "family": "Times New Roman"}
    )

    ax.set_title(f'Matriz de Correlación – {nombre}',
                 fontsize=16, fontweight='bold', pad=14,
                 fontfamily='Times New Roman')
    ax.tick_params(axis='x', rotation=30, labelsize=13)
    ax.tick_params(axis='y', rotation=0,  labelsize=13)

    plt.tight_layout()
    plt.savefig(f'fig5_{empresa}_correlacion.png', dpi=150, bbox_inches='tight')
    plt.show()
