# ══════════════════════════════════════════════════════════════════════════
# FIG 7 — ARIMA real vs predicción h=5 (4 empresas 2x2)
# ══════════════════════════════════════════════════════════════════════════
fig, axes = plt.subplots(2, 2, figsize=(16, 10))
axes = axes.flatten()
fig.suptitle('ARIMA — Predicciones vs valores reales (h=5 días, período de test 2025)',
             fontsize=15, fontweight='bold', y=1.01)

for ax, empresa, nombre in zip(axes, empresas, nombres):
    color = COLORES[empresa]
    df    = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True).dropna()
    serie = df['adj_close']
    n_tr  = int(len(serie) * TRAIN_RATIO)
    train = serie.iloc[:n_tr]
    test  = serie.iloc[n_tr:]

    y_true, y_pred, fechas = [], [], []
    for i in range(len(test) - 5 + 1):
        historia = pd.concat([train, test.iloc[:i]])
        try:
            modelo   = ARIMA(historia, order=(0,1,0)).fit()
            forecast = modelo.forecast(steps=5)
            y_pred.append(forecast.iloc[-1])
            y_true.append(test.iloc[i + 4])
            fechas.append(test.index[i])
        except:
            continue

    mape = np.mean(np.abs((np.array(y_true) - np.array(y_pred)) / np.array(y_true))) * 100
    ax.plot(fechas, y_true, color=GRIS,  linewidth=1.5, label='Real', alpha=0.85)
    ax.plot(fechas, y_pred, color=color, linewidth=1.5, linestyle='--',
            label=f'ARIMA  MAPE: {mape:.2f}%')
    ax.set_title(nombre, fontsize=13, fontweight='bold')
    ax.set_ylabel('Precio (USD)')
    ax.legend(fontsize=10, frameon=False)
    ax.tick_params(axis='x', rotation=30, labelsize=9)
    ax.grid(linestyle='--', alpha=0.3)

plt.tight_layout()
plt.savefig('fig7_arima_pred_h5.png', dpi=150, bbox_inches='tight')
plt.show()
print('Guardada: fig7_arima_pred_h5.png')


