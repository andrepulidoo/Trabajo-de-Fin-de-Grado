# lstm final con las 4 empresas, 3 horizontes y 3 configuraciones (sin sentimiento, vader, finbert)

import os
import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping
import warnings
warnings.filterwarnings('ignore')

os.chdir(r'C:/Users/andre/OneDrive/Documentos/TFG')

empresas = ['microsoft', 'meta', 'google', 'amazon']
nombres  = ['Microsoft', 'Meta', 'Alphabet', 'Amazon']

TRAIN_RATIO   = 0.90
HORIZONTES    = [5, 10, 20]
RETRAIN_EVERY = 20

# hiperparametros elegidos en el grid search anterior
WINDOW  = 10
UNITS1  = 64
UNITS2  = 64
DROPOUT = 0.2
EPOCHS  = 30
BATCH   = 32

# tres configuraciones para comparar el efecto del sentimiento
CONFIGURACIONES = {
    'LSTM':         ['open', 'retorno_simple', 'volume', 'volatilidad_20'],
    'LSTM VADER':   ['open', 'retorno_simple', 'volume', 'volatilidad_20', 'vader_mean'],
    'LSTM FinBERT': ['open', 'retorno_simple', 'volume', 'volatilidad_20', 'finbert_mean'],
}

early_stop = EarlyStopping(monitor='val_loss', patience=5,
                           restore_best_weights=True, verbose=0)

def crear_secuencias(X, y, window):
    Xs, ys = [], []
    for i in range(window, len(X)):
        Xs.append(X[i - window:i])
        ys.append(y[i])
    return np.array(Xs), np.array(ys)

def construir_lstm(n_features):
    modelo = Sequential([
        LSTM(UNITS1, return_sequences=True, input_shape=(WINDOW, n_features)),
        Dropout(DROPOUT),
        LSTM(UNITS2, return_sequences=False),
        Dropout(DROPOUT),
        Dense(1)
    ])
    modelo.compile(optimizer='adam', loss='mse')
    return modelo

resultados = []

for empresa, nombre in zip(empresas, nombres):
    df = pd.read_csv(f'dataset_{empresa}.csv', index_col='date', parse_dates=True).dropna()
    n_train = int(len(df) * TRAIN_RATIO)
    print(f"\n{nombre.upper()}")

    for h in HORIZONTES:
        print(f"  Horizonte {h} dias")
        target_col = f'target_{h}'

        for label, features in CONFIGURACIONES.items():

            # predigo la diferencia para evitar extrapolacion fuera del rango de entrenamiento
            data = df[features + ['adj_close', target_col]].dropna().copy()
            data['target_diff'] = data[target_col] - data['adj_close']

            X_all      = data[features].values
            y_all      = data['target_diff'].values
            close_all  = data['adj_close'].values
            target_all = data[target_col].values
            n_test     = len(data) - n_train

            y_real_list = []
            y_pred_list = []

            for i in range(n_test - h + 1):
                # reentrano periodicamente con todos los datos disponibles hasta ese momento
                if i % RETRAIN_EVERY == 0:
                    X_hist = X_all[:n_train + i]
                    y_hist = y_all[:n_train + i]

                    scaler_X = StandardScaler()
                    scaler_y = StandardScaler()
                    X_sc = scaler_X.fit_transform(X_hist)
                    y_sc = scaler_y.fit_transform(y_hist.reshape(-1, 1)).flatten()

                    X_seq, y_seq = crear_secuencias(X_sc, y_sc, WINDOW)

                    modelo = construir_lstm(len(features))
                    modelo.fit(X_seq, y_seq,
                               epochs=EPOCHS,
                               batch_size=BATCH,
                               validation_split=0.1,
                               callbacks=[early_stop],
                               verbose=0)

                X_pred_raw = X_all[n_train + i - WINDOW: n_train + i]
                X_pred_sc  = scaler_X.transform(X_pred_raw)
                X_pred_seq = X_pred_sc.reshape(1, WINDOW, len(features))

                y_pred_sc   = modelo.predict(X_pred_seq, verbose=0).flatten()
                y_pred_diff = scaler_y.inverse_transform(y_pred_sc.reshape(-1, 1)).flatten()[0]

                # precio predicho = precio actual + diferencia predicha
                precio_actual = close_all[n_train + i]
                y_pred_precio = precio_actual + y_pred_diff
                y_real_precio = target_all[n_train + i + h - 1]

                y_pred_list.append(y_pred_precio)
                y_real_list.append(y_real_precio)

            y_pred_arr = np.array(y_pred_list)
            y_real_arr = np.array(y_real_list)

            mae  = mean_absolute_error(y_real_arr, y_pred_arr)
            rmse = np.sqrt(mean_squared_error(y_real_arr, y_pred_arr))
            mape = np.mean(np.abs((y_real_arr - y_pred_arr) / y_real_arr)) * 100

            print(f"    {label}: MAE={mae:.3f}  RMSE={rmse:.3f}  MAPE={mape:.2f}%")

            resultados.append({
                'empresa':   nombre,
                'modelo':    label,
                'horizonte': h,
                'MAE':  round(mae, 3),
                'RMSE': round(rmse, 3),
                'MAPE': round(mape, 2)
            })

df_res = pd.DataFrame(resultados)
df_res.to_csv('resultados_lstm.csv', index=False)
print("\nresultados guardados en resultados_lstm.csv")
