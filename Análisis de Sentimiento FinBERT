import pandas as pd
from transformers import pipeline
import torch

# cargo el modelo finbert que esta preentrenado para noticias financieras
finbert = pipeline(
    "text-classification",
    model="ProsusAI/finbert",
    device=0 if torch.cuda.is_available() else -1,
    truncation=True,
    max_length=512
)

def get_finbert_score(texts, batch_size=64):
    results = []
    for i in range(0, len(texts), batch_size):
        batch = texts[i:i+batch_size]
        preds = finbert(batch, truncation=True, max_length=512)
        for pred in preds:
            label = pred['label']
            score = pred['score']
            # convierto la etiqueta a un numero entre -1 y 1
            if label == 'positive':
                compound = score
            elif label == 'negative':
                compound = -score
            else:
                compound = 0.0
            results.append({'finbert_label': label, 'finbert_compound': compound})
    return results

empresas = ['microsoft', 'meta', 'google', 'amazon']

for empresa in empresas:
    print(f"Procesando {empresa}...")
    df = pd.read_csv(f'noticias_{empresa}_clean.csv')

    # aplico finbert a todos los titulares
    scores = get_finbert_score(df['title'].astype(str).tolist())
    scores_df = pd.DataFrame(scores)
    df = pd.concat([df.reset_index(drop=True), scores_df], axis=1)

    # agrego por dia para tener un sentimiento diario
    df['date'] = pd.to_datetime(df['published']).dt.date
    daily = df.groupby('date').agg(
        finbert_mean     = ('finbert_compound', 'mean'),
        finbert_positive = ('finbert_label', lambda x: (x == 'positive').sum()),
        finbert_negative = ('finbert_label', lambda x: (x == 'negative').sum()),
        finbert_neutral  = ('finbert_label', lambda x: (x == 'neutral').sum()),
        n_noticias       = ('title', 'count')
    ).reset_index()

    df.to_csv(f'noticias_{empresa}_finbert.csv', index=False)
    daily.to_csv(f'sentimiento_{empresa}_finbert_daily.csv', index=False)
    print(f"{len(df)} noticias, {len(daily)} dias procesados")
